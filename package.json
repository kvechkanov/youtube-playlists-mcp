{
  "name": "youtube-playlists-mcp",
  "version": "0.2.0",
  "description": "Personal MCP server for the YouTube Data API v3: manage playlists and search videos, with OAuth and a quota-saving search cache.",
  "license": "MIT",
  "author": "Kostya Vechkanov <kvechkanov1@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "youtube-playlists-mcp": "dist/index.js",
    "youtube-playlists-mcp-auth": "dist/auth-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "youtube",
    "youtube-data-api",
    "playlist",
    "oauth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvechkanov/youtube-playlists-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/kvechkanov/youtube-playlists-mcp#readme",
  "bugs": {
    "url": "https://github.com/kvechkanov/youtube-playlists-mcp/issues"
  }
}
